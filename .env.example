# Copia este archivo a .env.local y llena los valores (nunca subas .env.local).

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Correos a clientes (SMTP). Con Gmail: smtp.gmail.com, puerto 465, el correo y una
# "contraseña de aplicación" (no la contraseña normal). Sin esto, la tienda funciona pero no envía correos.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
CORREO_REMITENTE="BIOPUREX <correo@ejemplo.com>"

# Opcional: dirección pública para los enlaces de los correos (si no, se usa la del navegador).
SITIO_URL=

# Límite de intentos de login/registro/recuperar (huellas HMAC). Valor aleatorio largo, solo servidor.
LIMITE_SECRETO=
